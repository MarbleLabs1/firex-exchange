;\n            if (!nametag) return;\n            try {\n                await fetch(\u0027/api/nametag\u0027, {\n                    method: \u0027POST\u0027,\n                    headers: {\u0027Content-Type\u0027: \u0027application/json\u0027},\n                    body: JSON.stringify({ nametag })\n                });\n                alert(\u0027Nametag set!\u0027);\n            } catch (error) {\n                console.error(\"Error setting nametag:\", error);\n            }\n        });\n\n        sendMessageBtn.addEventListener(\u0027click\u0027, async () \u003d\u003e {\n            const target_peer_id \u003d targetPeerIdInput.value;\n            const content \u003d messageContentInput.value;\n            if (!target_peer_id || !content) return;\n            try {\n                await fetch(\u0027/api/messages\u0027, {\n                    method: \u0027POST\u0027,\n                    headers: {\u0027Content-Type\u0027: \u0027application/json\u0027},\n                    body: JSON.stringify({ target_peer_id, content })\n                });\n                messageContentInput.value \u003d \u0027\u0027;\n                alert(\u0027Message sent!\u0027);\n            } catch (error) {\n                console.error(\"Error sending message:\", error);\n            }\n        });\n        \n        searchUserBtn.addEventListener(\u0027click\u0027, async () \u003d\u003e {\n            const query \u003d searchNametagInput.value;\n            if (!query) return;\n            try {\n                const response \u003d await fetch(`/api/search/users?q\u003d${encodeURIComponent(query)}`);\n                const data \u003d await response.json();\n                searchResultsEl.innerHTML \u003d `Found: ${data.nametag} - ID: ${data.peer_id || \u0027Not found\u0027}`;\n            } catch (error) {\n                console.error(\"Error searching user:\", error);\n                searchResultsEl.innerHTML \u003d \"Search error.\";\n            }\n        });\n